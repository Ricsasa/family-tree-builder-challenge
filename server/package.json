{
  "name": "family-tree-builder-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "eval": "node --require dotenv/config --test 'src/evals/*.eval.js'",
    "eval:ambiguity": "node --require dotenv/config --test 'src/evals/ambiguity.eval.js'",
    "eval:dag": "node --require dotenv/config --test 'src/evals/dag-validation.eval.js'",
    "eval:relations": "node --require dotenv/config --test 'src/evals/relations.eval.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  }
}
